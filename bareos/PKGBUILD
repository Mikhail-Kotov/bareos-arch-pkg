# Maintainer: local
# Monolithic Bareos build (director, storage, file daemon, bconsole, tools,
# PostgreSQL catalog backend, python plugins) from the upstream git tag.
pkgname=bareos
pkgver=25.1.1
pkgrel=1
pkgdesc='Bareos - Backup Archiving REcovery Open Sourced (all-in-one, PostgreSQL catalog)'
arch=(x86_64)
url='https://www.bareos.org'
license=(AGPL-3.0-or-later)
depends=(openssl zlib lzo jansson libcap acl readline postgresql-libs python gcc-libs bash)
makedepends=(cmake git rpcsvc-proto pkgconf)
optdepends=('glusterfs: GlusterFS storage backend and file daemon plugin (built if found)')
options=(!lto)
source=("git+https://github.com/bareos/bareos.git#tag=Release/${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd bareos
  # distname.sh: on CachyOS lsb_release doesn't report a known distributor, the
  # /etc/arch-release fallback sets PLATFORM but leaves DISTVER empty, and cmake
  # dies with "list index: 1 out of range" in BareosGetDistInfo.cmake.
  sed -i 's/^         PLATFORM=archlinux$/&\n         DISTVER=rolling/' core/cmake/distname.sh
  # Upstream hardcodes -Werror; don't let new-compiler warnings (gcc 16) break the build.
  sed -i 's/set(BAREOS_WARNING_FLAGS -Werror -Wall -Wextra -Wshadow)/set(BAREOS_WARNING_FLAGS -Wall -Wextra -Wshadow)/' core/CMakeLists.txt
  # fmt >= 12 moved fmt::format() out of <fmt/core.h>; stored_conf.cc only includes core.h.
  sed -i 's|#include <fmt/core.h>|#include <fmt/format.h>|' core/src/stored/stored_conf.cc
  # fmt 12: FMT_STRING() is a plain const char* now, so Dfmt() must format it at runtime.
  sed -i 's|fmt::format(std::forward<Fmt>(fmt), std::forward<Args>(args)...)|fmt::format(fmt::runtime(std::forward<Fmt>(fmt)), std::forward<Args>(args)...)|' core/src/stored/backends/util.h
  # libstdc++ 16 no longer pulls in <cstring> transitively (std::strlen).
  sed -i 's|^#include <fmt/format.h>$|&\n#include <cstring>|' core/src/stored/backends/crud_storage.cc
  # On the "archlinux" platform upstream CMake skips core/platforms/systemd, so no
  # bareos-{dir,sd,fd}.service get installed. Build them like for every other systemd platform.
  sed -i '/STREQUAL archlinux)/{n;s/.*/    add_subdirectory(systemd)/}' core/platforms/CMakeLists.txt
}

build() {
  # Options carried over from the AUR PKGBUILD (which built 23.0.x), minus tray monitor/Qt.
  # The XXX_REPLACE_WITH_* values are placeholders in the config templates; bareos-config
  # deploy_config fills them with the real hostname and random passwords (as upstream's debian/rules).
  cmake -S bareos -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_SBINDIR=/usr/bin \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_LOCALSTATEDIR=/ \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib/bareos \
    -Dlibdir=/usr/lib/bareos \
    -Dlogdir=/var/log/bareos \
    -Dpiddir=/run/bareos \
    -Dsubsysdir=/run/bareos \
    -Dconfdir=/etc/bareos \
    -Dconfigtemplatedir=/usr/share/bareos/config \
    -Dworkingdir=/var/lib/bareos \
    -Dplugindir=/usr/lib/bareos/plugins \
    -Dscriptdir=/usr/lib/bareos/scripts \
    -Dbackenddir=/usr/lib/bareos/backends \
    -Darchivedir=/var/lib/bareos/storage \
    -Dbsrdir=/var/lib/bareos \
    -DBAREOS_BINARY_INFO="CachyOS local build" \
    -DBAREOS_JOBLOG_MESSAGE="CachyOS local build" \
    -Ddynamic-cats-backends=yes \
    -Ddynamic-storage-backends=yes \
    -Dpostgresql=yes \
    -Dlmdb=yes \
    -Dndmp=yes \
    -Dacl=yes \
    -Dopenssl=yes \
    -Ddir-user=bareos -Ddir-group=bareos \
    -Dsd-user=bareos  -Dsd-group=bareos \
    -Dfd-user=root    -Dfd-group=root \
    -Dscsi-crypto=yes \
    -Dsystemd=yes \
    -Dtraymonitor=no \
    -Ddir-password=XXX_REPLACE_WITH_DIRECTOR_PASSWORD_XXX \
    -Dfd-password=XXX_REPLACE_WITH_CLIENT_PASSWORD_XXX \
    -Dsd-password=XXX_REPLACE_WITH_STORAGE_PASSWORD_XXX \
    -Dmon-dir-password=XXX_REPLACE_WITH_DIRECTOR_MONITOR_PASSWORD_XXX \
    -Dmon-fd-password=XXX_REPLACE_WITH_CLIENT_MONITOR_PASSWORD_XXX \
    -Dmon-sd-password=XXX_REPLACE_WITH_STORAGE_MONITOR_PASSWORD_XXX \
    -Dbasename=XXX_REPLACE_WITH_LOCAL_HOSTNAME_XXX \
    -Dhostname=XXX_REPLACE_WITH_LOCAL_HOSTNAME_XXX \
    -DENABLE_SYSTEMTESTS=OFF \
    -DENABLE_WEBUI=OFF \
    -DCMAKE_C_FLAGS="${CFLAGS} -Wno-use-after-free" \
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -Wno-use-after-free"
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  # /run is tmpfs - must not ship in the package, tmpfiles creates it instead
  rm -rf "${pkgdir}/run"

  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/sysusers.d/bareos.conf" <<'EOF'
g bareos - -
u bareos - "Bareos backup system" /var/lib/bareos /usr/bin/nologin
EOF

  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/tmpfiles.d/bareos.conf" <<'EOF'
d /run/bareos      0755 bareos bareos -
d /var/lib/bareos  0750 bareos bareos -
d /var/log/bareos  0750 bareos bareos -
EOF

  install -Dm644 bareos/AGPL-3.0.txt "${pkgdir}/usr/share/licenses/${pkgname}/AGPL-3.0.txt"
}
